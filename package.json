{
  "name": "google-photos-bulk-dl",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "Selected Google Photos downloads and local Takeout organization",
  "author": "",
  "license": "UNLICENSED",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "tsx --test tests/*.test.ts",
    "package": "npm run build && electron-builder",
    "docs:generate": "node scripts/docs.mjs generate",
    "docs:test": "node scripts/docs.mjs test",
    "docs:check": "node scripts/docs.mjs check",
    "smoke": "electron scripts/smoke.cjs",
    "format:check": "prettier --check src tests scripts package.json tsconfig.json .github"
  },
  "dependencies": {
    "exifr": "7.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.25.12",
    "jsdom": "30.1.3",
    "markdownlint-cli2": "0.24.0",
    "mermaid": "12.2.0",
    "prettier": "3.9.10",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "com.fazalhassan.googlephotosbulkdl",
    "productName": "Google Photos Bulk DL",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "artifacts"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.photography"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "maintainer": "GooglePhotosBulkDL contributors"
    }
  },
  "overrides": {
    "katex": "0.19.1",
    "re2js": "2.9.1"
  }
}
